{
  "about": "A run that outlasts the 45 s wait: the agent reads the cell later and doesn't run it again. Tags: execution.still_running, WAIT_SECONDS.",
  "checks": [
    { "check": "no_rerun_of_still_running" },
    { "check": "no_rerun_of_still_running", "require": true, "soft": true },
    { "check": "no_errored_cells" },
    { "check": "final_message_contains_any", "texts": ["5050", "still running", "still be running", "is running"] },
    { "check": "output_contains", "texts": ["5050"], "soft": true },
    { "check": "final_message_contains_any", "texts": ["5050"], "soft": true }
  ]
}
