{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "(sh \"${CLAUDE_PLUGIN_ROOT}/launch/endeavor-mcp.sh\" --fetch-only </dev/null >/dev/null 2>&1 &)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_endeavor_endeavor__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/launch/endeavor-mcp.sh\" --hook >/dev/null 2>&1",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
